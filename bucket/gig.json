{
    "version": "1.0.0",
    "description": "YouTube, Facebook, Instagram, X, TikTok and Threads video downloader (up to 8K)",
    "homepage": "https://github.com/xauusd25/GigDownloader",
    "license": "MIT",
    "depends": [
        "python",
        "ffmpeg",
        "deno"
    ],
    "url": "https://github.com/xauusd25/GigDownloader/archive/refs/tags/v1.0.0.zip",
    "hash": "bfcb69a4c71f5bc0cedffddc3d16ab07bd641162d2c038498e3aa9dd25a26c5c",
    "extract_dir": "GigDownloader-1.0.0",
    "installer": {
        "script": [
            "python -m venv \"$dir\\venv\"",
            "& \"$dir\\venv\\Scripts\\python.exe\" -m pip install --upgrade pip",
            "& \"$dir\\venv\\Scripts\\python.exe\" -m pip install --upgrade \"yt-dlp[default]\" yt-dlp-threads \"https://github.com/xauusd25/GigDownloader/archive/refs/tags/v$version.zip\""
        ]
    },
    "bin": [
        [
            "venv\\Scripts\\gig.exe",
            "gig"
        ],
        [
            "venv\\Scripts\\gigdownloader.exe",
            "gigdownloader"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/xauusd25/GigDownloader/archive/refs/tags/v$version.zip",
        "extract_dir": "GigDownloader-$version"
    }
}
